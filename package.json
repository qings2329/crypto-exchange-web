{
  "name": "crypto-exchange-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:analyze": "tsc -b && ANALYZE=true vite build",
    "preview": "vite preview",
    "test:fe": "vitest run",
    "test:fe:watch": "vitest",
    "dev:mock": "npm --prefix mock install --no-audit --no-fund && node mock/gateway.mjs",
    "test": "npm --prefix mock install --no-audit --no-fund && npm --prefix mock test && node mock/monitor-e2e.mjs",
    "test:mock": "npm --prefix mock install --no-audit --no-fund && npm --prefix mock test",
    "test:e2e": "npm --prefix mock install --no-audit --no-fund && node mock/monitor-e2e.mjs",
    "test:kline": "npm --prefix mock install --no-audit --no-fund && node mock/kline-ws.e2e.mjs"
  },
  "dependencies": {
    "lightweight-charts": "^5.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "web-vitals": "^6.1.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vitest": "^2.1.9"
  }
}
